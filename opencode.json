{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai-compatible/claude-opus-4-8",
  "default_agent": "code-workflow",

  "instructions": ["AGENTS.md", "CLAUDE.md"],

  "skills": {
    "paths": [".opencode/skills"]
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git reflog*": "allow",
      "sudo *": "allow",
      "rm *": "allow",
      "rmdir *": "allow",
      "git push*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git commit*": "allow",
      "git merge*": "allow",
      "git rebase*": "allow",
      "git cherry-pick*": "allow",
      "git reset*": "allow",
      "git clean*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git restore*": "allow",
      "git add .": "allow",
      "git add*": "allow",
      "git rm*": "allow",
      "git mv*": "allow",
      "git stash*": "allow",
      "git tag*": "allow",
      "git remote*": "allow",
      "git worktree*": "allow",
      "git submodule*": "allow"
    },
    "external_directory": "allow"
  },

  "agent": {
    "code-workflow": {
      "description": "主工作代理：负责任务编排、最小化代码改动、协调子代理与最终汇报；默认具备完整工程操作能力，可访问当前工作区内外目录。所有输出均使用中文。",
      "mode": "primary",
      "model": "openai-compatible/claude-opus-4-8",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow"
        },
        "external_directory": "allow"
      }
    },

    "review": {
      "description": "审查代理：检查正确性、回归风险、边界条件、测试覆盖缺口；默认可访问当前工作区内外目录，不自我降级为只读。所有输出均使用中文。",
      "mode": "subagent",
      "model": "openai-compatible/claude-opus-4-8",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow"
        },
        "external_directory": "allow"
      }
    },

    "test": {
      "description": "验证代理：选择并执行最贴近本次变更的测试 / lint / 构建命令；默认可使用完整工程能力进行验证，不自我降级为只读。所有输出均使用中文。",
      "mode": "subagent",
      "model": "openai-compatible/claude-opus-4-6",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow"
        },
        "external_directory": "allow"
      }
    },

    "debug": {
      "description": "调试代理：复现失败 → 收集证据 → 定位根因 → 给出最小修复路径；默认可访问当前工作区内外目录并使用完整工程能力。所有输出均使用中文。",
      "mode": "subagent",
      "model": "openai-compatible/claude-opus-4-7",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow"
        },
        "external_directory": "allow"
      }
    },

    "tools-runner": {
      "description": "通用工具调用代理（function call 示例）：演示如何通过 MCP 工具完成外部查询、数据读取或受控操作；默认可调用已授权工具并使用完整工程能力。请在 tools 字段显式授权可用工具。所有输出均使用中文。",
      "mode": "subagent",
      "model": "openai-compatible/claude-opus-4-7",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow"
      }
    }
  },

  "mcp": {
    "echo": {
      "type": "local",
      "command": [
        "node",
        "examples/mcp-echo-server/server.js"
      ],
      "enabled": true,
      "description": "示例：本仓库自带的最小可运行 MCP server，暴露 echo / add 两个工具。详见 docs/MCP_GUIDE.md。"
    },

    "internal-api": {
      "type": "remote",
      "url": "https://mcp.example.com/sse",
      "headers": {
        "Authorization": "Bearer ${MCP_TOKEN}"
      },
      "enabled": false,
      "description": "示例：对接公司内部 API 网关。请把 url 与 MCP_TOKEN 替换为真实值后再启用。"
    }
  }
}