# 公司内部 OpenAI-Compatible 配置示例
# 复制为 .env 后填写真实值

# OpenAI-Compatible 接口地址，例如：
# https://llm.internal.company.com/v1
OPENAI_COMPATIBLE_BASE_URL=

# API Key
OPENAI_COMPATIBLE_API_KEY=

# 默认模型名，例如：
# gpt-4.1
# qwen2.5-coder
# deepseek-v3
OPENAI_COMPATIBLE_MODEL=

# 子代理模型名（可与默认模型相同，也可单独指定）
OPENAI_COMPATIBLE_REVIEW_MODEL=
OPENAI_COMPATIBLE_TEST_MODEL=
OPENAI_COMPATIBLE_DEBUG_MODEL=
OPENAI_COMPATIBLE_TOOLS_MODEL=
